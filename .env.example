# Copy to .env and adjust. Every variable is optional; defaults are shown. Keys stay out of the repository.

# ---------------------------------------------------------------------------------------------------------
# Upstream LLM (where requests that pass the guards go)
# ---------------------------------------------------------------------------------------------------------
# fake (offline, deliberately gullible model; default) | openrouter | openai | anthropic
BULWARK_UPSTREAM_PROVIDER=fake
# Model used when the client sends none or "auto". Empty = provider default
# (openrouter: nvidia/nemotron-3-ultra-550b-a55b:free, openai: gpt-5-mini, anthropic: claude-sonnet-5).
BULWARK_UPSTREAM_MODEL=
# OpenRouter fallback list (comma-separated), sent as `models` so OpenRouter can switch when one is overloaded.
BULWARK_UPSTREAM_FALLBACK_MODELS=
# Refuse any OpenRouter model id that does not end in ":free" (also checks the model that actually answered).
BULWARK_REQUIRE_FREE_MODELS=true
BULWARK_UPSTREAM_TIMEOUT_SECONDS=120
# OPENROUTER_API_KEY=sk-or-...
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Any OpenAI-compatible server works too (vLLM, LiteLLM, PII Shield, Azure OpenAI proxy).
OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------------------------------------
# Policies and tenants
# ---------------------------------------------------------------------------------------------------------
# Directory of policy YAML files (default: the packaged ones in src/bulwark/policies).
# BULWARK_POLICIES_DIR=
BULWARK_DEFAULT_POLICY=default
# Let clients pick a policy with the X-Bulwark-Policy header (tenants can still be restricted).
BULWARK_ALLOW_POLICY_HEADER=true
# YAML file mapping gateway API keys (SHA-256) to tenants and policies. Unset = open gateway (development).
# BULWARK_TENANTS_FILE=configs/tenants.example.yaml

# ---------------------------------------------------------------------------------------------------------
# Detection layers
# ---------------------------------------------------------------------------------------------------------
# The prompt-injection classifier (needs the `classifier` extra). false = heuristics only.
BULWARK_CLASSIFIER_ENABLED=true
BULWARK_CLASSIFIER_MODEL=protectai/deberta-v3-base-prompt-injection-v2
BULWARK_CLASSIFIER_THREADS=4
BULWARK_CLASSIFIER_PRELOAD=true
# LLM judge for borderline scores, used by policies with `layers: {judge: true}` (e.g. `strict`).
# Without a key for the judge provider the judge layer is unavailable (see /health).
BULWARK_JUDGE_PROVIDER=openrouter
BULWARK_JUDGE_MODEL=dots-studio/dots-3-note-preview:free
BULWARK_JUDGE_FALLBACK_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free

# ---------------------------------------------------------------------------------------------------------
# PII Shield (optional): personal-data check of answers, for policies with output.secrets.pii_shield: true
# ---------------------------------------------------------------------------------------------------------
# BULWARK_PII_SHIELD_URL=http://localhost:8001
BULWARK_PII_SHIELD_POLICY=support-chat
BULWARK_PII_SHIELD_TIMEOUT_SECONDS=10

# ---------------------------------------------------------------------------------------------------------
# Approvals, audit log and dashboard
# ---------------------------------------------------------------------------------------------------------
BULWARK_APPROVAL_TTL_SECONDS=3600
# JSONL file for audit records (scores, actions, rules, hashes, short redacted snippets). Unset = memory only.
# BULWARK_AUDIT_FILE=audit.jsonl
BULWARK_AUDIT_MAX_ENTRIES=2000
# Secret for the keyed hashes in the audit log. Unset = random per process.
# BULWARK_AUDIT_KEY=
BULWARK_RESULTS_DIR=results

# ---------------------------------------------------------------------------------------------------------
# Budget for real API calls (judge, playground and agent demo "real model", evaluation)
# ---------------------------------------------------------------------------------------------------------
BULWARK_LLM_CACHE_DIR=.cache/llm
BULWARK_LLM_LEDGER=results/calls.jsonl
BULWARK_LLM_MAX_CALLS=340
BULWARK_LLM_MIN_SECONDS_BETWEEN_REQUESTS=3.0
BULWARK_LLM_MAX_RETRIES=4

LOG_LEVEL=INFO
# console (human-readable) or json (one JSON object per line)
LOG_FORMAT=console
